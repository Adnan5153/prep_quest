subgraph Phase35Net["Phase 35 — Network Plumbing"]

F9["DioClient — 10s connect / 15s receive & send timeouts, JSON Accept/Content-Type, validateStatus 2xx-4xx"]
F10["AuthInterceptor — opt-in Bearer <idToken> via X-Require-Auth header (Quiz Hub is public)"]
F11["LoggerInterceptor — debug-only request/response/error logger"]
F12["RetryInterceptor — idempotent methods only (GET/HEAD), exponential backoff (baseDelay*2^attempt + jitter), 3 attempts, honours CancelToken"]
F13["api_envelope.dart — typed {success, message, data, pagination, errors} decoder → EnvelopeException"]
F14["ApiEndpoints.quizApiBaseUrl — overridable via --dart-define=QUIZ_API_BASE_URL"]

